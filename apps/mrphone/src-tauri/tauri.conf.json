{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mrphone",
  "version": "../package.json",
  "identifier": "de.mraudev.mrphone",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Michael Rau",
    "shortDescription": "SIP-Softphone",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMDhERTZBQkVGN0NCOTIKUldTU3kvZSthdDRJUGorVjcvT3ZUeDRvc3ptaC82MGhuczRUSkVuV3JzSnpTcEVnMVoyeCtYNDcK",
      "endpoints": [
        "https://github.com/mraudev/mrtools/releases/download/mrphone-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
